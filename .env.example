SCANDE_DOMAIN_ALLOWLIST=scribd.com,*.scribd.com,drive.google.com,docs.google.com
SCANDE_DRIVE_ROOT=
SCANDE_LOCAL_ROOT=D:\Đề thi
SCANDE_CONVERT_ROOT=D:\Chuyen doi
SCANDE_CONVERT_MAX_MB=50
SCANDE_SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe
SCANDE_JOB_TIMEOUT=600
SCANDE_RETRY_TRANSIENT=1
SCANDE_OCR_WARN=0.5
SCANDE_TEMP_TTL_HOURS=24
SCANDE_MAX_CONCURRENT=2
SCANDE_SYSTEM_CHROME=true
SCANDE_REDIS_URL=redis://localhost:6379/0

# Dữ liệu tài khoản (accounts.db, vault.key) — mặc định: D:\scan-de-data
SCANDE_DATA_DIR=

# Google OAuth liên kết "Kho đề thi" với Drive (tuỳ chọn — để trống là tắt)
# Tạo OAuth client tại https://console.cloud.google.com/apis/credentials
# Redirect URI: http://127.0.0.1:8765/callback
SCANDE_GOOGLE_CLIENT_ID=
SCANDE_GOOGLE_CLIENT_SECRET=
SCANDE_GOOGLE_CALLBACK_PORT=8765
